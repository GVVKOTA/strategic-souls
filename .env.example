# Cloudflare Workers + D1 authentication and provider configuration template.
# Never commit real secrets, tokens, or .env / .dev.vars files to Git.
# For Cloudflare Workers production, configure secrets via `wrangler secret put`
# or Cloudflare Dashboard -> Workers & Pages -> strategic-souls -> Settings -> Variables and Secrets.

# Optional Google OAuth (native Cloudflare Workers flow at /api/auth/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional X2 commercial market-data providers (server-only)
X2_OWNER_SUBJECT=
X2_TRUEDATA_BEARER_TOKEN=
X2_EODHD_API_TOKEN=

# Private Owner Read-Only Market-Data Gateway (Cloudflare Worker holds ONLY gateway config & service token)

# ANGELONE_API_KEY=
# ANGELONE_CLIENT_ID=
# ANGELONE_MPIN=

# Optional V3 local Supabase + Python quant worker stack (disabled by default)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=
V3_LOCAL_DEV=1
V3_GOOGLE_ENABLED=0
V3_QUANT_ENABLED=0
QUANT_WORKER_ACCESS_TOKEN=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
V3_HANDOFF_ENABLED=0
LEGACY_SITE_OWNER_SUBJECT=
SUPABASE_HANDOFF_SERVICE_KEY=

# Indian API stock plan hostname and server-only credential
INDIA_API_HOST=
INDIA_API_KEY=

# BharatStock credential for the dashboard, injected server-side
BHARATSTOCK_API_KEY=
