# Existing legacy notebooks use the Sites D1 binding and genuine platform identity.
# V3 uses supported Supabase HTTPS Auth/REST/RPC, with tokens kept server-side.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=
V3_LOCAL_DEV=1
V3_GOOGLE_ENABLED=0
V3_QUANT_ENABLED=0
# Separate worker uses a restricted authenticated identity, never a browser service key.
QUANT_WORKER_ACCESS_TOKEN=
# Google credentials belong in the local Supabase environment, never browser code.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
# Disabled until explicit verified owner handoff setup. Never infer identity by email.
V3_HANDOFF_ENABLED=0
LEGACY_SITE_OWNER_SUBJECT=
SUPABASE_HANDOFF_SERVICE_KEY=
# DB is a platform-managed D1 binding, not a browser environment variable.
# Sites supplies authenticated identity headers. Never set these from a client.
# Future provider credentials require separate signed licences and server adapters.
# No payments, AI API, broker, analytics or commercial provider is enabled.

# X2 server-only variables actually read by lib/x2/data-service.ts/providers.ts.
# Leave provider tokens blank until a supported licence and exact mappings exist.
# For hosted use, set secrets through Sites runtime settings; never paste a real
# native owner subject or token into source, README, CI logs or GitHub issues.
X2_OWNER_SUBJECT=
X2_TRUEDATA_BEARER_TOKEN=
X2_EODHD_API_TOKEN=
# The isolated local preview (if used) provides its own fictional owner subject.
# A .env file alone does not configure a Cloudflare Worker binding or a hosted Site.
