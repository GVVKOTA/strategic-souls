# Dependencies
/node_modules/
/.pnp
.pnp.*
# Keep authored Yarn tooling if the project adopts Yarn.
/.yarn/*
!/.yarn/patches/
!/.yarn/plugins/
!/.yarn/releases/
!/.yarn/versions/

# Generated builds and framework state
/dist/
/.next/
/.vinext/
/out/
next-env.d.ts
*.tsbuildinfo

# Test output
/coverage/

# Package-manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Local environment and keys
.env*
.dev.vars*
!.env.example
!.dev.vars.example
/.secrets/
*.local.secret
*.pem
*.key
*.p12
*.pfx

# Checkout-local tool state
/.wrangler/
/.sites-runtime/

# Workspace scaffolding and publication archives
/.agents/
/.codex/
/outputs/
/work/

# OS metadata
.DS_Store

# Private Python quant environment and caches
/backend/quant/.venv/
/backend/quant/.data/
/backend/quant/**/__pycache__/
/backend/quant/.pytest_cache/
*.pyc

# Private local database/log/archive artifacts
*.log
*.sqlite
*.sqlite3
*.sqlite-journal
*.sqlite-shm
*.sqlite-wal
*.db
*.db-shm
*.db-wal
*.bundle
*.zip
*.tar
