{
  "name": "strategic-souls-private-research",
  "version": "3.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-pnpm.sh",
    "dev": "node tooling/local-preview.mjs launch",
    "build": "node tooling/run-framework.mjs build",
    "start": "node --import ./tooling/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "test": "node --experimental-strip-types --experimental-vm-modules --test \"tests/**/*.test.mjs\"",
    "typecheck": "tsc --noEmit",
    "verify:x2": "node tooling/check-x2-release.mjs",
    "lint:app": "eslint app frontend backend database",
    "verify": "npm run typecheck && npm run lint:app && npm test",
    "audit:security": "pnpm audit --audit-level high",
    "test:quant": "uv run --project backend/quant pytest backend/quant/tests -q",
    "db:start": "supabase --workdir ../database start",
    "db:migrate:local": "supabase --workdir ../database migration up --local",
    "local:setup": "node tooling/local-preview.mjs setup",
    "local:serve": "node tooling/local-preview.mjs serve",
    "dev:hmr": "node tooling/run-framework.mjs dev",
    "broker:setup": "node ../operations/scripts/setup-broker-secrets.mjs",
    "broker:adapter": "node --experimental-strip-types ../operations/scripts/start-market-adapter.mjs",
    "broker:verify": "node --experimental-strip-types ../operations/scripts/verify-angelone-live.mjs",
    "scan:secrets": "node ../operations/scripts/scan-secrets.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.31.0",
    "maplibre-gl": "^6.18.0",
    "next": "16.4.5",
    "react": "19.2.9",
    "react-dom": "19.2.9"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@electric-sql/pglite": "0.5.15",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.5",
    "prettier": "3.9.10",
    "react-server-dom-webpack": "19.2.9",
    "supabase": "3.0.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.1.6",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.5"
    }
  },
  "packageManager": "pnpm@11.25.0"
}
